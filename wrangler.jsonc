{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sensory-radio",
  "compatibility_date": "2026-04-17",
  "main": "worker.js",
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "kv_namespaces": [
    {
      "binding": "SETTINGS",
      "id": "90149deded7542dca910987990b5ace6"
    }
  ],
  "observability": {
    "enabled": true
  }
}
